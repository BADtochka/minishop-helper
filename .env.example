# Параметры runtime.
NODE_ENV=production
HOST=0.0.0.0
PORT=1337
LOG_FORMAT=json
JOB_POLL_INTERVAL_MS=1000

# Telegram.
OWNER_TELEGRAM_ID=123456789
TELEGRAM_TOKEN=
# В production разрешён только webhook.
TELEGRAM_MODE=webhook
TELEGRAM_DROP_PENDING_UPDATES=false
# Обязателен только для webhook.
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=http://localhost:1337

# Codex.
# Каталог сохраняет авторизацию Codex между перезапусками.
CODEX_HOME=./.data/codex
CODEX_WORKSPACE=./.data/codex-workspace
CODEX_BIN=codex
CODEX_REQUEST_TIMEOUT_MS=120000
CODEX_MODEL=
CODEX_EFFORT=

# Хранилище и контекст.
DATABASE_PATH=./.data/bot.sqlite
# project_context использует только cached profile; repository добавляет постоянный read-only checkout.
CONTEXT_MODE=project_context
# Используется только в режиме repository; это постоянное хранилище, не временная папка job.
REPOSITORIES_PATH=./.data/repositories
REPOSITORY_REFRESH_TIMEOUT_MS=30000

# Шифрование provider credentials.
# Ключ AES-256-GCM: base64 из 32 байт или 64 шестнадцатеричных символа.
APP_ENCRYPTION_KEY=

# GitHub App. Выдайте Issues (read/write), Contents (read), Metadata (read).
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Альтернатива GITHUB_APP_PRIVATE_KEY: путь к PEM, доступный runtime-пользователю.
GITHUB_APP_PRIVATE_KEY_FILE=

# GitLab OAuth.
GITLAB_BASE_URL=https://gitlab.com
# Необязательное точное переопределение callback; иначе используется PUBLIC_URL + /auth/gitlab/callback.
GITLAB_REDIRECT_URI=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
